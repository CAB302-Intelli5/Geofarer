<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Separator?>
<?import java.net.URL?>

<fx:root type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controllers.CountryDetailController"
    prefWidth="960" prefHeight="600"
    stylesheets="@../styles/base.css"
    styleClass="country-detail-root" spacing="0">

    <!-- Top Header Bar -->
    <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="10.0" styleClass="header-bar">
        <StackPane alignment="CENTER">
            <Circle radius="20" fill="white" />
            <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/Logo.png" />
                </image>
            </ImageView>
        </StackPane>

        <Label text="Geofarer" styleClass="geofarer-heading"/>

        <Region HBox.hgrow="ALWAYS" />

    <StackPane fx:id="userCirclePane" alignment="CENTER_RIGHT">
            <Circle fill="white" radius="20" stroke="white" strokeWidth="2" style="-fx-cursor: hand" />
            <ImageView fx:id="userImageView" fitHeight="40" fitWidth="40" />
        </StackPane>
        <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
        </padding>
    </HBox>

    <!-- Navigation Menu -->
    <HBox alignment="CENTER" prefHeight="50.0" spacing="30.0" styleClass="nav-bar-bg">
        <Button styleClass="nav-bar-text" text="Game Modes"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Separator orientation="VERTICAL" style="-fx-background-color: #A6A186; -fx-pref-width: 2;" />

        <Button styleClass="nav-bar-text" text="Explore"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Separator orientation="VERTICAL" style="-fx-background-color: #A6A186; -fx-pref-width: 2;" />

        <Button styleClass="nav-bar-text" text="Leaders"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Separator orientation="VERTICAL" style="-fx-background-color: #A6A186; -fx-pref-width: 2;" />

        <Button styleClass="nav-bar-text" text="My Passport"
                HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <!-- Country Title Banner with Progress Badge and Back Button -->
    <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0" style="-fx-padding: 20;" styleClass="title-banner">
        <Button fx:id="backButton" onAction="#handleBackAction" 
                text="← Back" 
                style="-fx-background-color: #0D1A26; -fx-text-fill: #E4F2F1; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 10 20;" />
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="CENTER" spacing="5" styleClass="country-header">
            <Label fx:id="countryNameLabel" text="Country Name" styleClass="country-name" />
            <Label fx:id="continentLabel" text="Continent" styleClass="country-continent" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    <Label fx:id="progressBadge" text="Fully Unlocked" styleClass="progress-badge" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #E4F2F1; -fx-background-color: #0D1A26; -fx-padding: 8 16; -fx-background-radius: 20;" />
    </HBox>

    <!-- Main Content -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-border-color: transparent; -fx-background-color: #001122;"
                styleClass="detail-scroll page-content" VBox.vgrow="ALWAYS">
        <content>
            <VBox alignment="TOP_CENTER" spacing="32" styleClass="detail-content page-content" style="-fx-padding: 40 20; -fx-background-color: #001122;">
                
                <!-- Progress Section -->
                <VBox spacing="16" styleClass="progress-section" alignment="CENTER" maxWidth="600" style="-fx-border-color: rgba(242,195,167,0.8), rgba(255,255,255,0.3); -fx-border-width: 1, 2; -fx-border-radius: 12;">
                    <Label text="Completion Progress" styleClass="section-title" />
                    <ProgressBar fx:id="progressBar" prefWidth="520" prefHeight="24" progress="0.0" styleClass="progress-bar" />
                    <Label fx:id="progressValueLabel" text="0% complete" styleClass="progress-value" />
                </VBox>

                <!-- Unlocked Hints Section -->
                <VBox spacing="20" styleClass="hints-section" alignment="TOP_CENTER" maxWidth="600" style="-fx-border-color: rgba(242,195,167,0.8), rgba(255,255,255,0.3); -fx-border-width: 1, 2; -fx-border-radius: 12;">
                    <Label text="Unlocked Hints" styleClass="section-title" />
                    <VBox fx:id="hintsContainer" spacing="16" styleClass="hints-container" alignment="TOP_CENTER" />
                </VBox>

                <!-- Locked Hints Section -->
                <VBox spacing="20" styleClass="locked-section" alignment="TOP_CENTER" maxWidth="600" style="-fx-border-color: rgba(242,195,167,0.8), rgba(255,255,255,0.3); -fx-border-width: 1, 2; -fx-border-radius: 12;">
                    <Label text="Locked Hints" styleClass="section-title" />
                    <VBox fx:id="lockedHintsContainer" spacing="16" styleClass="locked-hints-container" alignment="TOP_CENTER" />
                </VBox>
                
            </VBox>
        </content>
    </ScrollPane>

    <!-- Footer -->
    <HBox alignment="CENTER" prefHeight="40.0" style="-fx-padding: 10;" styleClass="footer-bg">
        <Label text="Complete hints to master this country!" style="-fx-font-size: 12px; -fx-text-fill: #0D1A26; -fx-font-style: italic;" />
    </HBox>

</fx:root>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<fx:root type="javafx.scene.layout.VBox" spacing="0" xmlns="http://javafx.com/javafx/17" 
         xmlns:fx="http://javafx.com/fxml/1" alignment="TOP_LEFT" 
         styleClass="stats-root" stylesheets="@../styles/user-stats.css"
         fx:controller="controllers.UserStatsController">

    <!-- Top Header Bar -->
    <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="10.0" styleClass="stats-header">
        <Region HBox.hgrow="ALWAYS" />
        <Label text="My Statistics - Performance Overview">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS" />
        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/logo_placeholder.png" />
            </image>
        </ImageView>
        <Button fx:id="loginButton" onAction="#handleLoginButton" 
                style="-fx-background-color: transparent; -fx-cursor: hand;" text="Login">
            <graphic>
                <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo_placeholder.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
        </padding>
    </HBox>

    <!-- Navigation Menu -->
    <HBox alignment="CENTER" prefHeight="50.0" spacing="30.0" styleClass="stats-nav-bar">
        <Button styleClass="nav-button" text="Game Modes" onAction="#handleGameModes" />
        <Button styleClass="nav-button" text="Explore" onAction="#handleExplore" />
        <Button styleClass="nav-button" text="Leaders" onAction="#handleLeaders" />
        <Button styleClass="nav-button" text="My Passport" onAction="#handleMyPassport" />
        <Button styleClass="nav-button" style="-fx-font-weight: bold; -fx-text-fill: #731A12;" 
                text="My Stats" onAction="#handleMyStats" />
    </HBox>

    <!-- Main Content Area with ScrollPane -->
    <ScrollPane fitToWidth="true" styleClass="stats-scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="0">
            
            <!-- Title Section with Underline -->
            <VBox styleClass="stats-title-container">
                <Label text="My Stats" styleClass="stats-title" />
                <Region prefHeight="10" />
                <Rectangle styleClass="stats-title-underline" />
            </VBox>

            <!-- Stats Cards Section -->
            <VBox styleClass="stats-cards-container">
                <Label text="Your Achievements" styleClass="section-header" />
                <Label text="Track your progress and milestones" styleClass="section-subheader" />
                
                <HBox spacing="20" alignment="CENTER">
                    <!-- Stamps Earned Card -->
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label fx:id="stampsEarnedNumber" text="0" styleClass="stat-number" />
                        <Label text="Countries Mastered" styleClass="stat-label" />
                    </VBox>
                    
                    <!-- Total Wins Card -->
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label fx:id="totalWinsNumber" text="0" styleClass="stat-number" />
                        <Label text="Total Wins" styleClass="stat-label" />
                    </VBox>
                </HBox>
                
                <Region prefHeight="20" />
                
                <HBox spacing="20" alignment="CENTER">
                    <!-- Hints Unlocked Card -->
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label fx:id="hintsUnlockedNumber" text="0" styleClass="stat-number" />
                        <Label text="Hints Unlocked" styleClass="stat-label" />
                    </VBox>
                    
                    <!-- Countries Played Card -->
                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <Label fx:id="countriesPlayedNumber" text="0" styleClass="stat-number" />
                        <Label text="Countries Played" styleClass="stat-label" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- List of Stamps/Mastered Countries -->
            <VBox styleClass="stats-cards-container">
                <Label text="Mastered Countries" styleClass="section-header" />
                <Label text="Countries you've fully unlocked" styleClass="section-subheader" />
                
                <ScrollPane fitToWidth="true" prefHeight="200" maxHeight="200" 
                           style="-fx-background: transparent; -fx-background-color: transparent;">
                    <VBox fx:id="masteredCountriesList" styleClass="stamps-list-container" />
                </ScrollPane>
            </VBox>

            <!-- Rank Section -->
            <VBox styleClass="stats-cards-container" alignment="CENTER">
                <VBox styleClass="rank-container" maxWidth="600">
                    <Label text="Your Current Rank" styleClass="rank-title" />
                    <Label fx:id="rankNameLabel" text="Beginner" styleClass="rank-name" />
                    <Label fx:id="rankDescriptionLabel" 
                           text="Keep exploring to advance your rank!" 
                           styleClass="rank-description" />
                </VBox>
            </VBox>

            <!-- Charts Section -->
            <VBox styleClass="charts-container">
                <Label text="Performance Analytics" styleClass="section-header" />
                <Label text="Visual insights into your geography mastery" styleClass="section-subheader" />
                
                <!-- Continent Mastery Spider Chart -->
                <VBox styleClass="chart-box">
                    <Label text="Continent Mastery Overview" styleClass="chart-title" />
                    <VBox fx:id="spiderChartContainer" alignment="CENTER" prefHeight="400" />
                </VBox>
                
                <Region prefHeight="20" />
                
                <!-- Progression Line Chart -->
                <VBox styleClass="chart-box">
                    <Label text="Mastery Progression by Match" styleClass="chart-title" />
                    <VBox fx:id="progressionChartContainer" alignment="CENTER" prefHeight="400" />
                </VBox>
                
                <Region prefHeight="20" />
                
                <!-- Continent Progress Bar Chart -->
                <VBox styleClass="chart-box">
                    <Label text="Progress by Continent" styleClass="chart-title" />
                    <VBox fx:id="continentBarChartContainer" alignment="CENTER" prefHeight="400" />
                </VBox>
            </VBox>

            <!-- Footer -->
            <HBox styleClass="stats-footer" prefHeight="40.0">
                <Label text="Keep playing to unlock more achievements and climb the ranks!" 
                       styleClass="footer-text" />
            </HBox>

        </VBox>
    </ScrollPane>

</fx:root>

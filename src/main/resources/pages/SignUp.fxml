<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!-- Border around the outside -->
<?import javafx.scene.image.ImageView?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.SignUpController"
            prefWidth="800" prefHeight="500"
            style="-fx-background-image: url('images/Map.png');
                   -fx-background-size: 100% 100%;
                   -fx-background-repeat: no-repeat;
                   -fx-background-position: center;
                   -fx-border-color: #0D1A26;
                   -fx-border-width: 20;">

    <top>
        <!-- User icon in top right corner -->
        <HBox alignment="TOP_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <StackPane fx:id="userCirclePane" onMouseClicked="#onUserCircleClick">
                <Circle radius="20" stroke="white" strokeWidth="2" fill="white"/>
                <ImageView fx:id="userImageView" fitWidth="40" fitHeight="40"/>
            </StackPane>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox alignment="TOP_CENTER" spacing="20">
                <!-- GEOFARER title -->
                <Label text="GEOFARER - Sign Up"
                       style="-fx-font-family: 'Inika'; -fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #0D1A26;"/>
                <!-- Inner box that contains signing up details for user to enter -->
                <VBox alignment="CENTER" spacing="15"
                      maxWidth="400" prefWidth="400"
                      style="-fx-background-color: #731A12BF; -fx-padding: 20; -fx-border-color: #FFFFFF; -fx-border-width: 2;">
                    <!-- Label for creating an account -->
                    <Label text="Please enter your email and password to create an account with us!"
                           wrapText="true" maxWidth="360" textAlignment="CENTER"
                           style="-fx-font-family: 'TASA Explorer'; -fx-font-size: 16px; -fx-text-fill: #FFFFFF;"/>
                    <!-- Enter email text box -->
                    <TextField fx:id="emailField" promptText="Enter your email here..." maxWidth="Infinity"/>
                    <StackPane maxWidth="Infinity">
                        <!-- Enter password text box (with hidden and viewable) -->
                        <PasswordField fx:id="passwordField" promptText="Enter your password here..." maxWidth="Infinity"/>
                        <TextField fx:id="passwordVisibleField" promptText="Enter your password here..." maxWidth="Infinity" visible="false"/>
                    </StackPane>

                    <!-- Password requirements -->
                    <Label fx:id="passwordRequirementsLabel"
                           text="Your password must meet the following requirements: At least 1 uppercase letter, at least 1 lowercase letter, at least 1 number, at least 1 symbol (@$!&amp;%*?.), length must be between 8 and 256 characters"
                           wrapText="true"
                           maxWidth="360"
                           style="-fx-font-family: 'TASA Explorer'; -fx-font-size: 12px; -fx-text-fill: white;"
                           textAlignment="LEFT"
                           alignment="TOP_LEFT"
                           visible="false"
                           managed="false">
                        <VBox.margin>
                            <Insets top="5" bottom="5"/>
                        </VBox.margin>
                    </Label>

                    <!-- Show/Hide password checkbox -->
                    <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                        <Region HBox.hgrow="ALWAYS"/>
                        <CheckBox fx:id="showPasswordCheckBox" text="👁" onAction="#onTogglePassword" style="-fx-text-fill: white;"/>
                    </HBox>
                    <!-- Buttons for signing up and going back -->
                    <HBox alignment="CENTER" spacing="20" maxWidth="Infinity">
                        <Button fx:id="goBackButton" text="Go Back" onAction="#onGoBackClick" prefWidth="120" style="-fx-font-family: 'TASA Explorer';"/>
                        <Button fx:id="signupButton" text="Sign Up" onAction="#onSignUpClick" prefWidth="120" style="-fx-font-family: 'TASA Explorer';"/>
                    </HBox>

                    <Label text="Already have an account? Login here."
                           onMouseClicked="#onLoginLinkClick"
                           style="-fx-text-fill: white; -fx-underline: true; -fx-cursor: hand;"
                           wrapText="true">
                        <VBox.margin>
                            <Insets top="10"/>
                        </VBox.margin>
                    </Label>

                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
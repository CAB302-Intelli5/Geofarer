
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!-- Border around the outside -->
<?import javafx.scene.image.ImageView?>
<?import java.net.URL?>
<?import java.lang.String?>

<?import javafx.scene.image.Image?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.SignUpController"
            prefWidth="800" prefHeight="500">

    <stylesheets>
        <URL value="@../styles/base.css"/>
    </stylesheets>

    <styleClass>
        <String fx:value="background-map"/>
        <String fx:value="border-pane"/>
    </styleClass>

    <top>
        <HBox prefHeight="70" spacing="10" styleClass="header-bar">
            <!-- Top left corner: logo -->
            <StackPane alignment="CENTER">
                <Circle radius="20" fill="white" />
                <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#onGoBackClick" >
                    <image>
                        <Image url="@../images/Logo.png"/>
                    </image>
                </ImageView>
            </StackPane>
            <Region HBox.hgrow="ALWAYS" />

            <!-- Top centre: Website name -->
            <Label text="Geofarer" alignment="CENTER" onMouseClicked="#onGoBackClick" styleClass="geofarer-heading"/>
                <Region HBox.hgrow="ALWAYS" />

            <!-- Top right corner: User icon (for profile) -->
            <StackPane fx:id="userCirclePane" alignment="CENTER_RIGHT" onMouseClicked="#onUserCircleClick">
                <Circle fill="white" radius="20" stroke="white" strokeWidth="2" styleClass="login-icon-button" />
                <ImageView fx:id="userImageView" fitHeight="40" fitWidth="40" />
            </StackPane>
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox alignment="TOP_CENTER" spacing="20">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
                <!-- Sign up title -->
                <Label text="Sign Up"
                       styleClass="secondary-label"/>
                <!-- Inner box that contains signing up details for user to enter -->
                <VBox alignment="CENTER" spacing="15"
                      maxWidth="400" prefWidth="400"
                      styleClass="user-shadow-box">
                    <!-- Label for creating an account -->
                    <Label text="Please enter your email and password to create an account with us!"
                           wrapText="true" maxWidth="360" textAlignment="CENTER"
                           styleClass="details-label"/>
                    <!-- Enter email text box -->
                    <TextField fx:id="emailField" promptText="Enter your email here..." maxWidth="Infinity"/>
                    <StackPane maxWidth="Infinity">
                        <!-- Enter password text box (with hidden and viewable) -->
                        <PasswordField fx:id="passwordField" promptText="Enter your password here..." maxWidth="Infinity"/>
                        <TextField fx:id="passwordVisibleField" promptText="Enter your password here..." maxWidth="Infinity" visible="false"/>
                    </StackPane>
                    <!-- Show/Hide password checkbox -->
                    <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                        <Region HBox.hgrow="ALWAYS"/>
                        <CheckBox fx:id="showPasswordCheckBox" text="👁" onAction="#onTogglePassword" styleClass="details-label"/>
                    </HBox>
                    <!-- Buttons for signing up and going back -->
                    <HBox alignment="CENTER" spacing="20" maxWidth="Infinity">
                        <Button fx:id="signupButton" text="Sign Up" onAction="#onSignUpClick" prefWidth="120" style="-fx-font-family: 'TASA Explorer';"/>
                    </HBox>

                    <Label text="Already have an account? Login here."
                           onMouseClicked="#onLoginLinkClick"
                           style="-fx-text-fill: white; -fx-underline: true; -fx-cursor: hand;"
                           wrapText="true">
                        <VBox.margin>
                            <Insets top="10"/>
                        </VBox.margin>
                    </Label>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
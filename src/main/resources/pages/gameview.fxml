<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.shape.Circle?>
<fx:root type="javafx.scene.layout.VBox" spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" alignment="TOP_LEFT" style="-fx-background-color: #0D1A26;" >
        <!-- Top Header Bar -->
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="10.0" style="-fx-background-color: #0D1A26; -fx-padding: 10;">

            <StackPane alignment="CENTER">
                <Circle radius="20" fill="white" />
                <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/Logo.png" />
                    </image>
                </ImageView>
            </StackPane>

                <Region HBox.hgrow="ALWAYS" />

                <Label text="GEOFARER">
                    <font>
                        <Font size="28.0" />
                    </font>
                    <style>
                        -fx-font-family: 'Inika';
                        -fx-text-fill: white;
                        -fx-font-weight: bold;
                    </style>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="loginButton" onAction="#handleLoginButton" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'TASA Explorer'; -fx-cursor: hand;" text="Login">
                    <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/login_icon.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
        </HBox>

        <!-- Navigation Menu -->
        <HBox alignment="CENTER" prefHeight="50.0" spacing="30.0" style="-fx-background-color: #0D1A26; -fx-border-color: white; -fx-border-width: 4;">
                <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'TASA Explorer'; -fx-font-size: 18px; -fx-padding: 5 20; -fx-alignment: CENTER; -fx-cursor: hand;" text="Game Modes" onAction="#handleGameModes"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Separator orientation="VERTICAL" style="-fx-background-color: white; -fx-pref-width: 2;" />

                <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'TASA Explorer'; -fx-font-size: 18px; -fx-padding: 5 20; -fx-alignment: CENTER; -fx-cursor: hand;" text="Explore" onAction="#handleExplore"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Separator orientation="VERTICAL" style="-fx-background-color: white; -fx-pref-width: 2;" />

                <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'TASA Explorer'; -fx-font-size: 18px; -fx-padding: 5 20; -fx-alignment: CENTER; -fx-cursor: hand;" text="Leaders" onAction="#handleLeaders"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Separator orientation="VERTICAL" style="-fx-background-color: white; -fx-pref-width: 2;" />

                <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'TASA Explorer'; -fx-font-size: 18px; -fx-padding: 5 20; -fx-alignment: CENTER; -fx-cursor: hand;" text="My Passport" onAction="#handleMyPassport"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    <!-- Target Country label -->
    <HBox alignment="CENTER" prefHeight="50.0"
          style="-fx-background-color: #731A12; -fx-padding:10;">
        <Label fx:id="targetCountryLabel"
               text="Target Country: Loading..."
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'TASA Explorer'; "/>
    </HBox>
    <!-- Game map -->
        <HBox alignment="CENTER">
            <StackPane fx:id="mapContainer"
                       maxWidth="Infinity"
                       VBox.vgrow="ALWAYS"
                       HBox.hgrow="NEVER"
                       style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2px;">
                <StackPane fx:id="innerMapPane">
                    <ImageView fx:id="imageView" preserveRatio="true" fitWidth="${innerMapPane.width}" fitHeight="${innerMapPane.height}" />
                    <Pane fx:id="overlay" />
                </StackPane>

                <Button fx:id="viewSuccessButton" onAction="#handleSuccessButton" text="X" styleClass="view-Success-button"
                        StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin>
                        <Insets top="10" right="10"/>
                    </StackPane.margin>
                </Button>
            </StackPane>
        </HBox>

        <!-- Bottom Bar for Country Label -->
        <HBox alignment="CENTER" prefHeight="40.0" style="-fx-background-color: #731A12;">
                <Label fx:id="countryLabel" text="Click on a country to see its name">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <style>
                        -fx-font-family: 'TASA Explorer';
                        -fx-text-fill: white;
                        -fx-font-weight: bold;
                    </style>
                </Label>
        </HBox>

        <!-- Text Area for the country hints from the CIA Factbook database -->
    <HBox alignment="BOTTOM_RIGHT" maxWidth="Infinity" style="-fx-background-color: #0D1A26;">
        <Region HBox.hgrow="ALWAYS"/>
        <VBox>
            <TextArea fx:id="hintsTextArea" text="Loading hints..." wrapText="true" editable="false">
                <font>
                    <Font size="14.0" />
                </font>
                <style>
                    -fx-control-inner-background: #E4F2F1;
                    -fx-font-family: 'TASA Explorer';
                </style>
            </TextArea>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Go Back button -->
        <Button fx:id="goBackButton"
                text="Go Back"
                style="-fx-background-color: #731A12; -fx-text-fill: white; -fx-font-family: 'TASA Explorer'; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 6 14;">
            <HBox.margin>
                <Insets right="15" bottom="15"/>
            </HBox.margin>
        </Button>
    </HBox>
</fx:root>